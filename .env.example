# Weekend Wizard - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- MCP Server ---
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080

# --- Logging ---
LOG_LEVEL=INFO

# --- API Keys (all APIs used are free / keyless) ---
# No API keys required for Open-Meteo, Open Library, JokeAPI, Dog CEO, or Open Trivia.
